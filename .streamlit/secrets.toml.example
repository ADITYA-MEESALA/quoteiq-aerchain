# Paste these root-level values into Streamlit Community Cloud → App settings → Secrets.
# Never commit a real API key or create .streamlit/secrets.toml in Git.
AI_PROVIDER = "gemini"
GEMINI_API_KEY = "paste-your-google-ai-studio-key"
GEMINI_MODEL = "gemini-3.5-flash-lite"
GEMINI_TIMEOUT_SECONDS = "180"
QUOTEIQ_DATA_DIR = "data"
